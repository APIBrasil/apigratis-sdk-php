{
    "name": "jhowbhz/apigratis-sdk-php",
    "description": "SDK oficial PHP da plataforma APIBrasil - WhatsApp, SMS, consultas CPF/CNPJ, veiculos, CEP, correios, pagamentos e mais",
    "keywords": [
        "apigratis",
        "apibrasil",
        "whatsapp",
        "messages",
        "api",
        "api-rest",
        "brasil",
        "correios",
        "cep",
        "cpf",
        "cnpj",
        "sms",
        "pix",
        "boleto",
        "fipe",
        "placa",
        "serasa",
        "geolocation",
        "messages free",
        "php requests"
    ],
    "homepage": "https://apibrasil.com.br",
    "authors": [
        {
            "name": "Jhon",
            "email": "contato@apibrasil.com.br",
            "homepage": "https://apibrasil.com.br",
            "role": "Developer"
        }
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "orchestra/testbench": "^6.25"
    },
    "autoload": {
        "psr-4": {
            "ApiBrasil\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ApiBrasil\\Test\\": "tests"
        }
    },
    "support": {
        "issues": "https://github.com/APIBrasil/apigratis-sdk-php/issues",
        "docs": "https://doc.apibrasil.io",
        "source": "https://github.com/APIBrasil/apigratis-sdk-php"
    },
    "suggest": {
        "ext-curl": "Required by ApiBrasil\\ to requests in services.",
        "guzzlehttp/guzzle": "Guzzle is a PHP HTTP client library and framework for building RESTful web service clients."
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:contract": "phpunit --testsuite contract",
        "codegen": "php scripts/codegen.php"
    },
    "scripts-descriptions": {
        "test": "Roda a suite de testes unitarios (transporte fake, sem rede).",
        "test:contract": "Roda os testes de contrato contra o gateway real (APIBRASIL_CONTRACT=1).",
        "codegen": "Regenera src/Generated/Catalog.php a partir do catalogo do gateway."
    },
    "minimum-stability": "dev",
    "prefer-stable": false
}
